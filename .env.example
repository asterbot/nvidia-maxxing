# --- target service (very-important-project) ---
REPO_PATH=../very-important-project
COMPOSE_PROJECT=vip
API_SERVICE=api
LB_URL=http://localhost:8080
# Containers on another machine (e.g. laptop exposed via ngrok):
#   LB_URL=https://<domain>.ngrok-free.dev
#   DOCKER_HOST=https://<domain>.ngrok-free.dev:443/_docker/<token>   (read-only; see
#       very-important-project/scripts/docker-proxy.sh, which prints both lines)
#   GIT_AUTO_FETCH=1                                                 (fetch pushed commits before triage)
DOCKER_HOST=
GIT_AUTO_FETCH=0
GIT_FETCH_TIMEOUT_S=60

# --- local LLM (OpenAI-compatible). Must be local: no remote LLM calls. ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=nemotron-3-super
# smaller/faster alternative if latency hurts the demo:
# LLM_MODEL=nemotron-3-nano
LLM_API_KEY=ollama
LLM_MAX_STEPS=8
LLM_TIMEOUT_S=180
# 1 = deterministic fake LLM built on the heuristic ranking (no model needed)
LLM_FAKE=0

# --- read-only HTTP API for sandboxed OpenClaw/NemoClaw (maxxing serve / maxxing run --serve) ---
API_HOST=0.0.0.0
API_PORT=7070
# optional bearer token; when set, clients send "Authorization: Bearer <token>"
MAXXING_API_TOKEN=

# --- detector tuning ---
HEALTH_INTERVAL_S=2
SETTLE_S=6
COOLDOWN_S=90
RECOVERY_S=20
LOG_WINDOW_S=180
MAX_COMMITS=15
DB_PATH=incidents.db
